@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle

title Lockstep FPS - 架构与时序

' =========================
' 架构图
' =========================
package "UE 客户端" as UEClient {
  [Enhanced Input 输入]
  [ULockstepInputCollectorComponent\n输入采集组件]
  [ULockstepSubsystem\n(UDP 客户端 + 帧输入缓冲)]
  [ULockstepSimulationDriverSubsystem\n(固定步长驱动)]
  [BP_ThirdPersonCharacter\nApplyInputFrame()]
}

node "Lockstep Relay Server\n(Tools/LockstepRelayServer)" as Relay {
  [会话管理器\nHELLO/WELCOME/READY/START]
  [帧聚合器\n按帧收集 INPUT]
  [广播器\n发送 INPUT_BUNDLE]
}

database "Lockstep 配置\nConfig/DefaultGame.ini" as Cfg

[Enhanced Input 输入] --> [ULockstepInputCollectorComponent\n输入采集组件] : 采样 move/look/jump
[ULockstepInputCollectorComponent\n输入采集组件] --> [ULockstepSubsystem\n(UDP 客户端 + 帧输入缓冲)] : SubmitLocalInputFrame()
[ULockstepSubsystem\n(UDP 客户端 + 帧输入缓冲)] --> Relay : UDP INPUT
Relay --> [ULockstepSubsystem\n(UDP 客户端 + 帧输入缓冲)] : UDP INPUT_BUNDLE
[ULockstepSubsystem\n(UDP 客户端 + 帧输入缓冲)] --> [ULockstepSimulationDriverSubsystem\n(固定步长驱动)] : ConsumeFrameInputs(frame)
[ULockstepSimulationDriverSubsystem\n(固定步长驱动)] --> [BP_ThirdPersonCharacter\nApplyInputFrame()] : OnSimTick(frame, inputs)
Cfg --> [ULockstepSubsystem\n(UDP 客户端 + 帧输入缓冲)] : ServerHost/ServerPort
Cfg --> [ULockstepSimulationDriverSubsystem\n(固定步长驱动)] : FPS/InputDelayFrames

newpage

' =========================
' 时序图
' =========================

title Lockstep 握手与逐帧推进

actor 玩家 as P
participant "UE 客户端 A\nULockstepSubsystem" as A
participant "UE 客户端 B\nULockstepSubsystem" as B
participant "Relay Server" as S
participant "仿真驱动 A\nFixed Tick" as SA
participant "仿真驱动 B\nFixed Tick" as SB

P -> A : 启动游戏 / ConnectFromConfig()
P -> B : 启动游戏 / ConnectFromConfig()

A -> S : HELLO
B -> S : HELLO
S --> A : WELCOME(clientId=A, startFrame=0, fps)
S --> B : WELCOME(clientId=B, startFrame=0, fps)

A -> S : READY
B -> S : READY
S --> A : START
S --> B : START

loop 每个本地渲染帧
  A -> A : 采集输入\nBuildInputFrame(frame+delay)
  B -> B : 采集输入\nBuildInputFrame(frame+delay)
  A -> S : INPUT(frame N, player A)
  B -> S : INPUT(frame N, player B)

  S -> S : 按帧 N 聚合\n等待所有玩家输入齐全
  S --> A : INPUT_BUNDLE(frame N, all players)
  S --> B : INPUT_BUNDLE(frame N, all players)

  A -> SA : ConsumeFrameInputs(N)
  B -> SB : ConsumeFrameInputs(N)
  SA -> SA : OnSimTick(N, inputs)
  SB -> SB : OnSimTick(N, inputs)
end

note over A,S
V1 中服务器仅做 relay：\n无权威世界状态，\n无回滚、无纠正。
end note

@enduml
